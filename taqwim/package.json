{
	"name": "@kalimahapps/taqwim",
	"description": "PHP linter and formatter",
	"author": "khr2003",
	"version": "0.0.71",
	"homepage": "https://taqwim.kalimah-apps.com/docs/",
	"repository": {
		"type": "git",
		"url": "https://github.com/kalimahapps/taqwim.git"
	},
	"bugs": {
		"url": "https://github.com/kalimahapps/taqwim/issues"
	},
	"type": "module",
	"license": "MIT",
	"scripts": {
		"build": "tsc && vite build",
		"build-parser": "vite-node ./scripts/build-phpparser.ts",
		"build:watch": "tsc && vite build --watch",
		"coverage": "vitest run --coverage",
		"coverage:ui": "vite preview --outDir coverage/",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:watch": "vitest",
		"update-rules": "vite-node ./scripts/update-rules.ts",
		"watch": "tsc -w -p ./"
	},
	"dependencies": {
		"@kalimahapps/docblock-parser": "^1.2.1",
		"chalk": "^6.0.0",
		"change-case": "^5.4.4",
		"figlet": "^1.11.4",
		"glob": "^13.0.6",
		"levn": "^0.4.1",
		"minimatch": "^10.2.6",
		"yargs": "^18.1.0"
	},
	"devDependencies": {
		"@types/cli-progress": "^3.11.6",
		"@types/figlet": "^1.7.0",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^26.4.0",
		"@types/yargs": "^17.0.35",
		"@vitest/coverage-v8": "^4.1.11",
		"@vitest/ui": "^4.1.11",
		"cli-progress": "^3.12.0",
		"fs-extra": "^11.4.0",
		"globby": "^13.2.2",
		"php-parser": "^3.7.0",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vite-node": "^6.0.0",
		"vitest": "^4.1.11"
	},
	"keywords": [
		"php",
		"linter",
		"foramtter"
	],
	"bin": {
		"taqwim": "./dist/cli/index.js"
	},
	"files": ["dist"],
	"engines": {
		"node": ">=22"
	}
}